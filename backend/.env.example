DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_TIMEOUT_SECONDS=30
DEEPSEEK_MAX_RETRIES=2
DATABASE_URL=sqlite:///./math_graph_ai.db
AGENT_MODE=react
AGENT_MAX_STEPS=6
AGENT_TIMEOUT_SECONDS=45
AGENT_TOOL_TIMEOUT_SECONDS=10
AGENT_MAX_REPEATED_ACTIONS=1
AGENT_GOAL_REPAIR_ATTEMPTS=1
AGENT_MAX_MODEL_CALLS=6
AGENT_MAX_OBSERVATION_CHARS=2000
AGENT_TRACE_ENABLED=true
AGENT_PREFER_TOOL_CALLS=false
# false=不带聊天历史/会话摘要；当前画布表达式由独立开关控制
AGENT_INCLUDE_CHAT_HISTORY=false
# 当前画布是本轮决策事实，默认始终向模型提供表达式和标签
AGENT_INCLUDE_GRAPH_EXPRESSIONS=true
MAX_EQUATIONS=20
MAX_EXPRESSION_LENGTH=256
MAX_AST_NODES=128
MAX_AST_DEPTH=32
MAX_NUMERIC_CONSTANT=1000000
MAX_POWER_EXPONENT=100
MAX_VIEWPORT_ABS=1000000
MAX_ANALYSIS_CHARS=4000
MATH_SAMPLE_COUNT=400
MATH_TOLERANCE=1e-6
MATH_MAX_POINTS=32
CONTEXT_RECENT_MESSAGE_CHARS=2400
CONTEXT_MAX_RECENT_MESSAGES=16
CONTEXT_SUMMARY_MAX_CHARS=1200
MESSAGE_PAGE_SIZE=30
