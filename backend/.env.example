DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_TIMEOUT_SECONDS=30
DEEPSEEK_MAX_RETRIES=2
DATABASE_URL=sqlite:///./math_graph_ai.db
# 本地端口约定：前端 Vite 6106，后端 uvicorn --port 6108（见 README）
# Docker Compose 下由 compose 覆盖为 sqlite:////data/math_graph_ai.db；宿主映射默认亦为 6106/6108
# 可选：逗号分隔 CORS 源；同域 nginx 反代时可留空
# CORS_ORIGINS=http://localhost:6106,http://127.0.0.1:6106
# react=提交；shadow=对照不提交；off=单步。发布 react 前须过 docs/release-checklist.md
AGENT_MODE=react
# 复合指令建议 ≥12；过小会 max_steps_exceeded 并回滚未提交更改
AGENT_MAX_STEPS=30
AGENT_TIMEOUT_SECONDS=90
AGENT_TOOL_TIMEOUT_SECONDS=10
AGENT_MAX_REPEATED_ACTIONS=1
AGENT_GOAL_REPAIR_ATTEMPTS=3
AGENT_TOOL_REPAIR_ATTEMPTS=3
AGENT_MAX_MODEL_CALLS=30
AGENT_MAX_OBSERVATION_CHARS=2000
AGENT_TRACE_ENABLED=true
# json 或 tool_calls；真实模型契约评测通过前保持 json
AGENT_DECISION_PROTOCOL=json
AGENT_DECISION_TEMPERATURE=0
AGENT_FEW_SHOT_ENABLED=true
AGENT_DYNAMIC_TOOLS_ENABLED=true
# 旧兼容开关；新配置优先使用 AGENT_DECISION_PROTOCOL
AGENT_PREFER_TOOL_CALLS=false
# false=不带聊天历史/会话摘要；当前画布表达式由独立开关控制
AGENT_INCLUDE_CHAT_HISTORY=false
# 当前画布是本轮决策事实，默认始终向模型提供表达式和标签
AGENT_INCLUDE_GRAPH_EXPRESSIONS=true
MAX_EQUATIONS=20
MAX_EXPRESSION_LENGTH=256
MAX_AST_NODES=128
MAX_AST_DEPTH=32
MAX_NUMERIC_CONSTANT=1000000
MAX_POWER_EXPONENT=100
MAX_VIEWPORT_ABS=1000000
MAX_ANALYSIS_CHARS=4000
MATH_SAMPLE_COUNT=400
MATH_TOLERANCE=1e-6
MATH_MAX_POINTS=32
CONTEXT_RECENT_MESSAGE_CHARS=2400
CONTEXT_MAX_RECENT_MESSAGES=16
CONTEXT_SUMMARY_MAX_CHARS=1200
MESSAGE_PAGE_SIZE=30
